<resources>
    <!-- Bare launch theme: Compose owns all real theming (see ColorOSTheme). This just avoids a
         white flash and a visible action bar before the first frame is drawn.
         windowShowWallpaper makes the system wallpaper visible behind the window, like any real
         launcher — Compose content (see WorkspacePager) must in turn avoid painting an opaque
         background over it. -->
    <style name="Theme.ColorOSLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
</resources>
